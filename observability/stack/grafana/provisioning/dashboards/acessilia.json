{
  "uid": "acessilia-visao-geral",
  "title": "Acessília — visão geral",
  "tags": ["acessilia"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requisições por segundo",
      "description": "Vazão da API por rota. Precisa de ENABLE_METRICS=true.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{job=\"acessilia-api\"}[1m]))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latência p95",
      "description": "95% das requisições respondem abaixo desta linha. Latência interna, sem rede do cliente.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"acessilia-api\"}[1m])))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Erros 5xx (%)",
      "description": "Fatia das requisições que falharam por erro do servidor.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"acessilia-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"acessilia-api\"}[5m])), 0.001) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Status da API",
      "description": "Se o Prometheus está conseguindo coletar. Fora do ar aqui costuma ser ENABLE_METRICS desligado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "refId": "A", "expr": "up{job=\"acessilia-api\"}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "API fora do ar", "color": "red" },
                "1": { "text": "API no ar", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU e memória da máquina",
      "description": "Vem do node-exporter. Serve para saber se o gargalo é a máquina ou a aplicação.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %"
        },
        {
          "refId": "B",
          "expr": "avg((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)",
          "legendFormat": "RAM %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Fila e jobs ativos",
      "description": "Métricas de domínio do Acessília.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "acessilia_queue_size",
          "legendFormat": "Fila"
        },
        {
          "refId": "B",
          "expr": "sum(acessilia_jobs_active)",
          "legendFormat": "Ativos"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Jobs por status",
      "description": "Volume acumulado de jobs por status na execução atual.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (acessilia_jobs_total)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "LLM por agente",
      "description": "Chamadas e falhas de LLM acumuladas na execução atual.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (acessilia_llm_calls_total)",
          "legendFormat": "{{agent}} chamadas"
        },
        {
          "refId": "B",
          "expr": "sum by (agent) (acessilia_llm_failures_total)",
          "legendFormat": "{{agent}} falhas"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Logs da aplicação",
      "description": "Vem do Loki via Alloy. Erros e avisos do loguru.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "targets": [{ "refId": "A", "expr": "{job=\"acessilia\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ]
}
