# Runtime credentials only. Keep registry/update credentials in .deploy.env.
ENABLED_INTERFACES=telegram,web,api
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8001
BOT_TOKEN=
TEMP_DIR=/app/var/temp
DATA_DIR=/app/var/data
LOGS_DIR=/app/var/logs
LOG_LEVEL=INFO
AI_CLIENT=toolbox
PIPELINE_ENGINE=pddl
PDDL_EXECUTE_DRY_RUN=false
TOOLBOX_API_KEY=
TOOLBOX_PROVIDER=docling
TOOLBOX_VLM_PROVIDER=qwen3-vl-8b
TOOLBOX_ADJUDICATE_PROVIDER=qwen3-vl-8b
TOOLBOX_LAYOUT_PROVIDER=docling-layout
TOOLBOX_PDF_PROVIDER=pymupdf-pdf
TOOLBOX_MATH_RECOGNIZE_PROVIDER=pp-formulanet
TOOLBOX_MATH_PROVIDER=math-speech
TOOLBOX_OCR_PROVIDER=docling-ocr
TOOLBOX_ORIENTATION_PROVIDER=rapidocr-orient
TOOLBOX_USE_ARTIFACT_STORE=true
TOOLBOX_USE_REMOTE_CACHE=true
FUSION_MODE=dual
FUSION_SECONDARY_PROVIDER=mineru
FUSION_HYBRID_PROVIDER=mineru-hyb
FUSION_JUDGE_MAX_PAGES=5
FUSION_APPLY_PAGE_ROUTES=true
MODEL_CALL_TIMEOUT_SECONDS=3000
DATA_AGENT_TIMEOUT_SECONDS=3600
TOOLBOX_TIMEOUT_SECONDS=3600
# Copy the real public URLs, SMTP, observability and interface settings from
# the old production environment before activation. See .env.example for names.
