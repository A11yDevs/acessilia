# The Fast Downward image CI and fast_downward_docker.sh use (#790).
# One source for both: CI exports these lines into the job environment, and
# the script reads FAST_DOWNWARD_IMAGE from here when it is not set. To move to
# a new release, change both lines together; CI checks the version.
FAST_DOWNWARD_IMAGE=aibasel/downward@sha256:328732c5cb87e8c34f477a88a4f99977b6ea91ca5c1e859b886b5334c42d80e8
FAST_DOWNWARD_VERSION=26.6
