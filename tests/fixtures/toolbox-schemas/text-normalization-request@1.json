{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a11y-devs:schema:text-normalization-request:1.0.0",
  "$defs": {
    "TextTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "TextTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "targets": {
      "items": {
        "$ref": "#/$defs/TextTarget"
      },
      "maxItems": 256,
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "targets"
  ],
  "title": "NormalizationRequest",
  "type": "object"
}
