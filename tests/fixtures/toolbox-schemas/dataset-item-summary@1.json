{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a11y-devs:schema:dataset-item-summary:1",
  "title": "ItemSummary",
  "description": "A lightweight listing record, not the full item returned by get-item or sample.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "has_annotations": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "artifact_count",
    "has_annotations"
  ]
}
