{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a11y-devs:schema:dataset-sync-entry:1",
  "title": "DatasetSyncEntry",
  "description": "One mirrored artifact or a skipped item/artifact. Disabled mirroring produces a skipped entry with only status and reason.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "mirrored",
        "skipped"
      ]
    },
    "item": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "anyOf": [
    {
      "properties": {
        "status": {
          "const": "mirrored"
        }
      },
      "required": [
        "item",
        "split",
        "artifact"
      ]
    },
    {
      "properties": {
        "status": {
          "const": "skipped"
        }
      },
      "required": [
        "reason"
      ]
    }
  ]
}
