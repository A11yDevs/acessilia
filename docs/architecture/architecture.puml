@startuml architecture
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

title Processing architecture — PDDL engine

actor "User (Web / Telegram / CLI)" as User

package "Core (Docker container)" {

  package "Frontends (clients)" {
    component "Web panel (HTML)\nfrontend/web" as WebUI
    component "Telegram bot (aiogram)\nfrontend/telegram" as TelegramBot
    component "CLI runner\nfrontend/cli" as CLI
  }

  component "REST API (FastAPI)\nbackend/api" as API

  package "PDDL engine" {
    component "PddlAccessibilityOrchestrator\nlibs/core/src/acessilia_core/pipeline/orchestrator.py" as Orchestrator
    component "ToolboxManifestExtractor\nlibs/core/src/acessilia_core/manifest" as Manifest
    component "PlannerAgent\n(PDDL problem + plan validation)\nlibs/core/src/acessilia_core/planning" as Planner
    component "ExecutorAgent\n(Agno Workflow)\nlibs/core/src/acessilia_core/execution" as Executor

    package "Method handlers" {
      component "VisionAgent\n[Agno LLM]\nlibs/core/src/acessilia_core/agents/vision_agent.py" as Vision
      component "DataAgent\n[Agno LLM]\nlibs/core/src/acessilia_core/agents/data_agent.py" as Data
      component "Deterministic handlers\n(docstruct algorithms)" as Deterministic
    }
  }

  package "Canonical pipeline and exporters" {
    component "Canonical builder and sanitizer\nlibs/core/src/acessilia_core/pipeline\nschema-defined dictionaries" as Pipeline
    component "Renderers and exporters\n(TXT/DOCX/PDF/HTML/MP3)\nlibs/core/src/acessilia_core/export" as Exporters
    component "Pure serializers\nTXT / HTML / Pandoc AST / Markdown\nlibs/docstruct/export\nshared walker + format visitors" as PureExports
    artifact "Normative canonical JSON Schema\ndocstruct/schemas/accessible_document.schema.json" as CanonicalSchema
    artifact "Generated compatibility copy\nschemas/accessible_document.schema.json" as SchemaCopy
  }

  database "SQLite (WAL)\nvar/data/history.db" as DB
  folder "Cache\nvar/temp/cache" as Cache
}

cloud "Acessilia Toolbox\n(extraction, OCR, rendering,\nmath, PDF/UA)\nvia acessilia-sdk" as Toolbox
cloud "Ollama / OpenRouter\nvia Agno (get_agno_model)" as AI

User --> WebUI
User --> TelegramBot
User --> CLI
User --> API : direct REST

WebUI --> API
TelegramBot --> API
CLI --> API
API --> Orchestrator

Orchestrator --> DB
Orchestrator --> Cache

Orchestrator --> Manifest : 1. Extract the processing manifest
Manifest --> Toolbox
Orchestrator --> Planner : 2. Plan the obligations
Orchestrator --> Executor : 3. Run the plan
Executor --> Vision
Executor --> Data
Executor --> Deterministic
Executor --> Toolbox : operational capabilities
Vision --> AI
Data --> AI

Executor --> Pipeline : 4. Results
Pipeline --> Exporters : 5. Canonical document
note left of Pipeline
  Legacy CanonicalDocument / CanonicalSection remain
  compatibility exports, deprecated since 0.5.3 (ADR-0024).
  Construction, fields and pickle paths are preserved.
end note
Pipeline ..> CanonicalSchema : builder/schema contract tests
CanonicalSchema ..> SchemaCopy : sync/check developer tooling
note right of CanonicalSchema
  Wheel includes the fixed resource (ADR-0023).
  Validator engine is injected; validation is opt-in.
  Strict export-gate activation is separate (E1.2b).
end note
Exporters --> PureExports : labels, profile/target\npure serialization
Exporters --> Toolbox : PDF/UA render
Exporters --> User : 6. Accessible document

@enduml
