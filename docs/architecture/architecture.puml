@startuml architecture
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

title Processing architecture — PDDL engine

actor "User (Web / Telegram / CLI)" as User

package "Core (Docker container)" {

  package "Frontends (clients)" {
    component "Web panel (HTML)\nfrontend/web" as WebUI
    component "Telegram bot (aiogram)\nfrontend/telegram" as TelegramBot
    component "CLI runner\nfrontend/cli" as CLI
  }

  component "REST API (FastAPI)\nbackend/api" as API

  package "PDDL engine" {
    component "PddlAccessibilityOrchestrator\nbackend/agents/pddl_orchestrator.py" as Orchestrator
    component "ToolboxManifestExtractor\nbackend/core/manifest" as Manifest
    component "PlannerAgent\n(PDDL problem + plan validation)\nbackend/core/planning" as Planner
    component "ExecutorAgent\n(Agno Workflow)\nbackend/core/execution" as Executor

    package "Method handlers" {
      component "VisionAgent\n[Agno LLM]\nbackend/agents/vision_agent.py" as Vision
      component "DataAgent\n[Agno LLM]\nbackend/agents/data_agent.py" as Data
      component "Deterministic handlers\n(docstruct algorithms)" as Deterministic
    }
  }

  package "Canonical pipeline and exporters" {
    component "Canonical builder and sanitizer\nbackend/pipeline" as Pipeline
    component "Renderers and exporters\n(TXT/DOCX/PDF/HTML/MP3)\nbackend/export" as Exporters
  }

  database "SQLite (WAL)\nvar/data/history.db" as DB
  folder "Cache\nvar/temp/cache" as Cache
}

cloud "Acessilia Toolbox\n(extraction, OCR, rendering,\nmath, PDF/UA)\nvia acessilia-sdk" as Toolbox
cloud "Ollama / OpenRouter\nvia Agno (get_agno_model)" as AI

User --> WebUI
User --> TelegramBot
User --> CLI
User --> API : direct REST

WebUI --> API
TelegramBot --> API
CLI --> API
API --> Orchestrator

Orchestrator --> DB
Orchestrator --> Cache

Orchestrator --> Manifest : 1. Extract the processing manifest
Manifest --> Toolbox
Orchestrator --> Planner : 2. Plan the obligations
Orchestrator --> Executor : 3. Run the plan
Executor --> Vision
Executor --> Data
Executor --> Deterministic
Executor --> Toolbox : operational capabilities
Vision --> AI
Data --> AI

Executor --> Pipeline : 4. Results
Pipeline --> Exporters : 5. Canonical document
Exporters --> Toolbox : PDF/UA render
Exporters --> User : 6. Accessible document

@enduml
