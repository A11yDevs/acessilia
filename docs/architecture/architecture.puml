@startuml architecture
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
title Acessilia — PDDL processing architecture

actor "User (Web / Telegram / CLI)" as User
package "Frontend Clients" {
  component "Web Panel" as WebUI
  component "Telegram Bot" as TelegramBot
  component "CLI Runner" as CLI
}
component "REST API / Worker\nbackend/api" as API
component "Processing Service\nbackend/service.py" as Service
package "PDDL Workflow" {
  component "PddlAccessibilityOrchestrator\nbackend/agents/pddl_orchestrator.py" as Orchestrator
  component "Manifest Extraction\nbackend/core/manifest" as Manifest
  component "PlannerAgent\nbackend/core/planning" as Planner
  component "Executor (Agno Workflow)\nbackend/core/execution" as Executor
  component "Vision / Data Agents\nbackend/agents" as Agents
}
package "Canonical Pipeline & Exports" {
  component "Canonical Builder / Validators\nbackend/pipeline" as Pipeline
  component "Renderers / Exporters\nbackend/export" as Exporters
}
database "SQLite History" as DB
folder "Document Cache" as Cache
cloud "Acessilia Toolbox" as Toolbox
cloud "Ollama / OpenRouter\nAgno Model" as AI

User --> WebUI
User --> TelegramBot
User --> CLI
User --> API : Direct REST
WebUI --> API
TelegramBot --> API
CLI --> API
API --> Service
Service --> DB
Service --> Cache
Service --> Orchestrator
Orchestrator --> Manifest
Manifest --> Toolbox
Orchestrator --> Planner
Orchestrator --> Executor
Orchestrator --> Agents : Pre-plan enrichment
Orchestrator --> Executor : Optional dry-run validation
Agents --> AI
Orchestrator --> Pipeline
Pipeline --> Exporters
Exporters --> API : Accessible artifacts
@enduml
