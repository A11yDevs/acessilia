@startuml layers
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Usuário (Web / Telegram / CLI)" as User

rectangle "1. Frontend Layer (Interfaces)" as L1 {
  component "frontend/web/ (FastAPI)" as WebUI
  component "frontend/telegram/ (aiogram)" as TelegramBot
  component "frontend/cli/ (Runner)" as CLI
}

rectangle "2. Application Orchestration Layer" as L2 {
  component "backend/agents/orchestrator.py\n(AccessibilityOrchestrator)" as Orchestrator
  component "backend/agents/state_manager.py\n(StateManager)" as StateManager
  component "backend/services/queue_service.py\n(ProcessingQueue)" as Queue
}

rectangle "3. Multi-Agent & AI Layer (Agno)" as L3 {
  component "ReaderAgent\n[Função-step Determinístico]" as Reader
  component "VisionAgent & DataAgent\n[Agentes LLM em asyncio.gather]" as AgentsLLM
  component "EditorAgent\n[Função-step Determinístico]" as Editor
  component "backend/ai/ai_client.py\n(get_agno_model - Ollama/OpenRouter)" as AIClient
}

rectangle "4. Canonical Document Layer" as L4 {
  component "backend/pipeline/canonical_builder.py" as Builder
  component "backend/pipeline/sanitizer.py" as Sanitizer
  component "backend/pipeline/validators.py" as Validators
  component "schemas/accessible_document.schema.json" as Schema
}

rectangle "5. Output and Rendering Layer" as L5 {
  component "backend/export/pandoc_exporter.py" as Exporter
  component "backend/export/renderers/*\n(TXT / DOCX / PDF / HTML / MP3)" as Renderers
}

rectangle "6. Infrastructure & Persistence" as L6 {
  component "backend/services/cache.py" as Cache
  component "backend/services/history_service.py\n(MariaDB / SQLite)" as History
  component "backend/services/cleanup_service.py" as Cleanup
  component "backend/config/settings.py" as Settings
}

User --> L1
L1 --> L2
L2 --> L3
L3 --> L4
L4 --> L5
L5 --> User

L2 --> L6
L3 --> L6
L5 --> L6

note right of L2
  Coordena o workflow,
  gerenciando a fila e estados.
  Futuro: Orquestrador Dinâmico (Smart Router).
end note

note right of L3
  Pipeline de agentes:
  Reader -> (Vision/Data em paralelo) -> Editor.
end note

note right of L4
  O Documento Canônico é a
  única fonte da verdade para saída.
end note

@enduml