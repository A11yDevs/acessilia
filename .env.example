# Interfaces: "api,telegram,web" (default), "api,web", "api,telegram", etc.
# A API ("api") é o núcleo: os demais frontends (web, telegram) consomem via HTTP.
ENABLED_INTERFACES=api,telegram,web

# API Server (núcleo - obrigatório para web/telegram funcionarem)
API_HOST=0.0.0.0
API_PORT=8000
# URL pública da API usada pelo client HTTP e nos links de download (e-mail/Telegram)
API_BASE_URL=http://localhost:8000
# Porta do painel web (cliente da API)
WEB_PORT=8001

BOT_TOKEN=seu_token_aqui
REQUEST_TIMEOUT=3600
MAX_FILE_SIZE_MB=50
MAX_PAGES=50
MAX_PAGE_WIDTH=1600
JPG_QUALITY=85
PDF_SPLIT_DPI=150
PYMUPDF_TEXT_THRESHOLD=100
TESSERACT_CMD=tesseract

TEMP_DIR=var/temp
DATA_DIR=var/data
LOGS_DIR=var/logs

LOG_LEVEL=INFO
# Senha de leitura para rotas de observabilidade; vazio desabilita essas rotas.
OBSERVABILITY_API_TOKEN=

# AI Client: "ollama" (Ollama), "openrouter" (OpenRouter)
AI_CLIENT=ollama

# Structurer of the disabled legacy engine; the PDDL pipeline always extracts
# the structure on the Toolbox and only logs this value.
STRUCTURER=toolbox

# Acessilia Toolbox: runs every operational capability (structure extraction,
# PDF/UA, media inspection...). Default port 8002; inside Docker, use
# http://host.docker.internal:8002 to reach a Toolbox on the host.
TOOLBOX_BASE_URL=http://localhost:8002
# Optional: comma-separated URLs of independent Toolbox deployments, tried in
# order by the capability clients (docs/adr/0006). Empty uses TOOLBOX_BASE_URL.
TOOLBOX_BASE_URLS=
# Provedor registrado na Toolbox para extração (padrao: docling)
TOOLBOX_PROVIDER=docling
# Timeout em segundos para chamadas HTTP a Toolbox
TOOLBOX_TIMEOUT_SECONDS=3600
# Se true, faz upload do documento para /v1/artifacts antes de extrair
TOOLBOX_USE_ARTIFACT_STORE=true
# Se true, prefere usar cache remoto da Toolbox para extração estrutural
TOOLBOX_USE_REMOTE_CACHE=true
# Provedor registrado na Toolbox para inspeção determinística de mídia
# (media.inspect); padrao: pure-media-inspect
TOOLBOX_MEDIA_INSPECT_PROVIDER=pure-media-inspect
# Se true, executa media.inspect na Toolbox para detectar imagens isoladas que
# exigem audiodescrição. Não há fallback local: com false, a etapa é pulada; se
# a Toolbox falhar, o processamento segue sem o sinal, registra a causa e não
# grava o resultado degradado no cache (para não repeti-lo quando a Toolbox voltar).
TOOLBOX_MEDIA_INSPECT_ENABLED=true
# Voz do edge-tts usada na exportação MP3 (veja `edge-tts --list-voices`)
TTS_VOICE=pt-BR-FranciscaNeural
# Exportação PDF/UA (document.export.pdf_ua): a Toolbox renderiza com Pandoc e
# TeX Live fixados numa imagem própria e devolve o PDF como artefato (MinIO).
# Não há fallback local: com false, o formato é pulado; se a Toolbox falhar,
# a etapa é reportada como erro de exportação opcional.
TOOLBOX_PDF_UA_ENABLED=true
TOOLBOX_PDF_UA_PROVIDER=pandoc-pdf-ua
# Tempo máximo de espera pela Toolbox antes de reportar erro de exportação opcional
TOOLBOX_PDF_UA_TIMEOUT_SECONDS=300
# Provedores VLM da Toolbox: transcrição da página inteira (document.ocr.page),
# juiz pareado / transcrição de região (document.adjudicate.*) e regeneração de
# tabela (table.recognize). Padrão: qwen3-vl-8b.
TOOLBOX_PAGE_OCR_PROVIDER=qwen3-vl-8b
TOOLBOX_ADJUDICATE_PROVIDER=qwen3-vl-8b
TOOLBOX_TABLE_PROVIDER=qwen3-vl-8b
# Chave para autenticação Bearer na Toolbox (opcional)
# Se vazia, requisições são enviadas sem header Authorization
TOOLBOX_API_KEY=
# Gate de disponibilidade dos métodos PDDL que chamam a Toolbox, conferidos contra
# o catálogo vivo: observe (só registra), enforce (remove do plano; sem catálogo,
# falha fechado) ou off.
TOOLBOX_AVAILABILITY_GATE=observe
# Intervalo de releitura do catálogo e prazo máximo do último catálogo válido.
TOOLBOX_CATALOG_REFRESH_SECONDS=60
TOOLBOX_CATALOG_STALE_SECONDS=900

# Formula enrichment do Docling: modelo CodeFormula (local, ~800MB) converte
# formulas em LaTeX sem chamar LLM; fallback via DataAgent quando falha
DOCLING_FORMULA_ENRICHMENT=true

# Cascata local para imagens que contem formulas: OCR (RapidOCR) filtra e
# CodeFormula extrai LaTeX do recorte sem chamar LLM
FORMULA_IMAGE_CASCADE=true

# Pipeline engine: "pddl" is the only accepted value (InformationalStructural +
# Planner + Executor, with the Toolbox); the legacy engine is disabled.
PIPELINE_ENGINE=pddl

# PDDL settings (aceita aliases PMV_* para compatibilidade)
PDDL_EXECUTE_DRY_RUN=true
PDDL_PLANNER_BACKEND=internal
PDDL_PREFERRED_PLAN=internal
PDDL_FAST_DOWNWARD=
PDDL_FAST_DOWNWARD_ALIAS=
PDDL_FAST_DOWNWARD_SEARCH=astar(blind())
OLLAMA_API_KEY=sua_chave_aqui
OLLAMA_MODEL=nome-do-modelo
OLLAMA_BASE_URL=http://example.com:porta-aqui-se-diferente-da-padrao/v1/chat/completions
OPENROUTER_API_KEY=sk-or-v1-sua_chave_aqui
OPENROUTER_MODEL=nome-do-modelo
OPENROUTER_MAX_TOKENS=4096
# Tables can require a larger structured response than the general agent budget.
DATA_AGENT_MAX_TOKENS=8192
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=a11y-devs-describer

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_NAME=A11y Acessibilidade

# I18N Configuration
# See docs/i18n.md (and docs/i18n.pt-br.md) for the full internationalization guide:
# LOCALE selects the server-side locale (local logging/default output); I18N_LOCALES_ACTIVE
# lists the locales offered to remote users.
#LOCALE=pt_BR
I18N_LOCALES_ACTIVE=en_US,pt_BR
