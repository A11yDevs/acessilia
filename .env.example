# The staging/production scripts `source` this file in bash, so a value with
# spaces or shell characters ( ) & ; | < > must be quoted; compose and dotenv
# strip the quotes. `python scripts/sync_env.py` flags values that need them.

# Interfaces: "api,telegram,web" (default), "api,web", "api,telegram", etc.
# A API ("api") é o núcleo: os demais frontends (web, telegram) consomem via HTTP.
ENABLED_INTERFACES=api,telegram,web

# API Server (núcleo - obrigatório para web/telegram funcionarem)
API_HOST=0.0.0.0
API_PORT=8000
# API URL used by the frontends' HTTP client (web, Telegram)
API_BASE_URL=http://localhost:8000
# Public URL of the web panel, used in download links (e-mail/Telegram)
WEB_BASE_URL=http://localhost:8001
# Porta do painel web (cliente da API)
WEB_PORT=8001
# GIT_COMMIT, IMAGE_TAG and IMAGE_DIGEST come from the image build (infra/Dockerfile).
# Do not set them here: compose's env_file would overwrite the built values.

BOT_TOKEN=seu_token_aqui
REQUEST_TIMEOUT=3600
MAX_FILE_SIZE_MB=50
# Documentos com mais páginas são recusados com erro logo após a extração
# estrutural, antes do planejamento e das chamadas ao modelo de visão. O limite
# é sempre aplicado: o valor deve ser positivo, e o serviço não inicia com 0.
MAX_PAGES=50
PDF_SPLIT_DPI=150

TEMP_DIR=var/temp
DATA_DIR=var/data
LOGS_DIR=var/logs

LOG_LEVEL=INFO
# Senha de leitura para rotas de observabilidade; vazio desabilita essas rotas.
OBSERVABILITY_API_TOKEN=

# AI Client: "ollama" (Ollama), "openrouter" (OpenRouter)
AI_CLIENT=ollama

# Acessilia Toolbox: executa todas as capacidades operacionais (extração de
# estrutura, PDF/UA, inspeção de mídia...). Porta padrão 8002; dentro do Docker,
# use http://host.docker.internal:8002 para alcançar uma Toolbox no host.
TOOLBOX_BASE_URL=http://localhost:8002
# Optional: comma-separated URLs of independent Toolbox deployments, tried in
# order by the capability clients (docs/adr/0006). Empty uses TOOLBOX_BASE_URL.
TOOLBOX_BASE_URLS=
# Provedor registrado na Toolbox para extração (padrao: docling)
TOOLBOX_PROVIDER=docling
# Timeout em segundos para chamadas HTTP a Toolbox
TOOLBOX_TIMEOUT_SECONDS=3600
# Novas tentativas no mesmo endpoint após timeout ou instância indisponível
# (as capacidades da Toolbox são idempotentes); 0 as desliga. Como o timeout
# também é retentado, uma chamada pendurada pode levar até
# TOOLBOX_TIMEOUT_SECONDS * (TOOLBOX_RETRIES + 1) por endpoint.
# Base do backoff exponencial, em segundos:
TOOLBOX_RETRIES=1
TOOLBOX_RETRY_BACKOFF_SECONDS=0.5
# Se true, faz upload do documento para /v1/artifacts antes de extrair
TOOLBOX_USE_ARTIFACT_STORE=true
# Se true, prefere usar cache remoto da Toolbox para extração estrutural
TOOLBOX_USE_REMOTE_CACHE=true
# Provedor registrado na Toolbox para inspeção determinística de mídia
# (media.inspect); padrao: pure-media-inspect
TOOLBOX_MEDIA_INSPECT_PROVIDER=pure-media-inspect
# Se true, executa media.inspect na Toolbox para detectar imagens isoladas que
# exigem audiodescrição. Não há fallback local: com false, a etapa é pulada; se
# a Toolbox falhar, o processamento segue sem o sinal, registra a causa e não
# grava o resultado degradado no cache (para não repeti-lo quando a Toolbox voltar).
TOOLBOX_MEDIA_INSPECT_ENABLED=true
# Voz do edge-tts usada na exportação MP3 (veja `edge-tts --list-voices`)
TTS_VOICE=pt-BR-FranciscaNeural
# Exportação PDF/UA (document.export.pdf_ua): a Toolbox renderiza com Pandoc e
# TeX Live fixados numa imagem própria e devolve o PDF como artefato (MinIO).
# Não há fallback local: com false, o formato é pulado; se a Toolbox falhar,
# a etapa é reportada como erro de exportação opcional.
TOOLBOX_PDF_UA_ENABLED=true
TOOLBOX_PDF_UA_PROVIDER=pandoc-pdf-ua
# Tempo máximo de espera pela Toolbox antes de reportar erro de exportação opcional
TOOLBOX_PDF_UA_TIMEOUT_SECONDS=300
# Exportação DOCX (document.export.docx): a Toolbox renderiza com o mesmo Pandoc
# fixado e devolve o DOCX como artefato. Também sem fallback local: com false, o
# formato é pulado; se a Toolbox falhar, vira erro de exportação opcional.
TOOLBOX_DOCX_ENABLED=true
TOOLBOX_DOCX_PROVIDER=pandoc-docx
TOOLBOX_DOCX_TIMEOUT_SECONDS=300
# Provedores VLM da Toolbox: transcrição da página inteira (document.ocr.page),
# juiz pareado / transcrição de região (document.adjudicate.*) e regeneração de
# tabela (table.recognize). Padrão: qwen3-vl-8b.
TOOLBOX_PAGE_OCR_PROVIDER=qwen3-vl-8b
TOOLBOX_ADJUDICATE_PROVIDER=qwen3-vl-8b
TOOLBOX_TABLE_PROVIDER=qwen3-vl-8b
# Other Toolbox providers per capability (defaults in
# libs/sdk/src/acessilia_sdk/toolbox/capabilities.py): layout analysis
# (document.layout.analyze), PDF split/render (pdf.split, pdf.render), formula
# recognition (math.recognize), formula conversion/verbalization (math.convert,
# math.verbalize), region OCR (document.ocr) and page orientation
# (image.page.orient).
TOOLBOX_LAYOUT_PROVIDER=docling-layout
TOOLBOX_PDF_PROVIDER=pymupdf-pdf
TOOLBOX_MATH_RECOGNIZE_PROVIDER=docling-math
TOOLBOX_MATH_PROVIDER=math-speech
TOOLBOX_OCR_PROVIDER=docling-ocr
TOOLBOX_ORIENTATION_PROVIDER=rapidocr-orient
# Chave para autenticação Bearer na Toolbox (opcional)
# Se vazia, requisições são enviadas sem header Authorization
TOOLBOX_API_KEY=
# Gate de disponibilidade dos métodos PDDL que chamam a Toolbox, conferidos contra
# o catálogo vivo: observe (só registra), enforce (remove do plano; sem catálogo,
# falha fechado) ou off.
TOOLBOX_AVAILABILITY_GATE=observe
# Intervalo de releitura do catálogo e prazo máximo do último catálogo válido.
TOOLBOX_CATALOG_REFRESH_SECONDS=60
TOOLBOX_CATALOG_STALE_SECONDS=900

# Motor de pipeline: "pddl" é o único motor suportado (InformationalStructural +
# Planner + Executor, com a Toolbox); o antigo alias "pmv" é normalizado para
# ele. O antigo motor legacy foi removido.
PIPELINE_ENGINE=pddl

# Multi-provider fusion: "single" extracts with TOOLBOX_PROVIDER only; "dual"
# also extracts with FUSION_SECONDARY_PROVIDER and merges both via docstruct.
# Dual mode raises the fusion obligations (adjudicate-page, fuse-providers,
# select-table-source...) and the methods that resolve them, such as the VLM
# judge (vlm-pairwise-judge, which calls TOOLBOX_ADJUDICATE_PROVIDER and only
# runs with PDDL_EXECUTE_DRY_RUN=false).
FUSION_MODE=single
FUSION_SECONDARY_PROVIDER=mineru
# Id of the MinerU hybrid-VLM provider; to use it in dual fusion, set
# "mineru-hyb" as FUSION_SECONDARY_PROVIDER.
FUSION_HYBRID_PROVIDER=mineru-hyb
# Pages per document the VLM judge may check. A deterministic router settles
# each divergent page first; the judge only gets the ambiguous ones (both
# providers found a table or a formula, and the pages differ), most divergent
# first, and confirms the router's choice. The verdict is recorded, not applied.
# 0 turns the judge off. A disagreement is a technical warning.
FUSION_JUDGE_MAX_PAGES=5
# Take FUSION_SECONDARY_PROVIDER's page (MinerU) where the deterministic router
# prefers it: tables, formulas or a nearly empty primary page. Running text stays
# with TOOLBOX_PROVIDER. false keeps every page from the primary provider.
FUSION_APPLY_PAGE_ROUTES=true

# PDDL settings (aceita aliases PMV_* para compatibilidade)
PDDL_EXECUTE_DRY_RUN=true
# Replans after a method fails before the job gives up
PDDL_MAX_REPLANS=2
PDDL_PLANNER_BACKEND=internal
PDDL_PREFERRED_PLAN=internal
PDDL_FAST_DOWNWARD=
PDDL_FAST_DOWNWARD_ALIAS=
PDDL_FAST_DOWNWARD_SEARCH='astar(blind())'
OLLAMA_API_KEY=sua_chave_aqui
OLLAMA_MODEL=nome-do-modelo
OLLAMA_BASE_URL=http://example.com:porta-aqui-se-diferente-da-padrao/v1/chat/completions
OPENROUTER_API_KEY=sk-or-v1-sua_chave_aqui
OPENROUTER_MODEL=nome-do-modelo
OPENROUTER_MAX_TOKENS=4096
# Tables can require a larger structured response than the general agent budget.
DATA_AGENT_MAX_TOKENS=8192
# Budget of one image description. A model stuck repeating itself runs until
# this cuts it off, so it also bounds the cost of a degenerate answer.
VISION_REGION_MAX_TOKENS=1500
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=a11y-devs-describer

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_NAME='A11y Acessibilidade'

# I18N Configuration
# See docs/i18n.md (and docs/i18n.pt-br.md) for the full internationalization guide:
# LOCALE selects the server-side locale (local logging/default output); I18N_LOCALES_ACTIVE
# lists the locales offered to remote users.
#LOCALE=pt_BR
I18N_LOCALES_ACTIVE=en_US,pt_BR
