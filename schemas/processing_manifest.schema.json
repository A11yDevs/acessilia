{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "number"
        },
        "top": {
          "title": "Top",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "title": "Bottom",
          "type": "number"
        },
        "coord_origin": {
          "default": "UNKNOWN",
          "enum": [
            "TOPLEFT",
            "BOTTOMLEFT",
            "UNKNOWN"
          ],
          "title": "Coord Origin",
          "type": "string"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ExtractorRun": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "docling",
          "default": "docling",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        }
      },
      "required": [
        "version",
        "started_at",
        "completed_at",
        "duration_ms"
      ],
      "title": "ExtractorRun",
      "type": "object"
    },
    "ManifestElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list_item",
            "table",
            "picture",
            "formula",
            "code",
            "caption",
            "footnote",
            "page_header",
            "page_footer",
            "checkbox",
            "key_value",
            "form",
            "group",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        },
        "raw_label": {
          "minLength": 1,
          "title": "Raw Label",
          "type": "string"
        },
        "reading_order": {
          "minimum": 1,
          "title": "Reading Order",
          "type": "integer"
        },
        "hierarchy_level": {
          "minimum": 0,
          "title": "Hierarchy Level",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "parent_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Ref"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "raw_label",
        "reading_order",
        "hierarchy_level"
      ],
      "title": "ManifestElement",
      "type": "object"
    },
    "ManifestSummary": {
      "additionalProperties": false,
      "properties": {
        "page_count": {
          "minimum": 0,
          "title": "Page Count",
          "type": "integer"
        },
        "element_count": {
          "minimum": 0,
          "title": "Element Count",
          "type": "integer"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "obligation_count": {
          "minimum": 0,
          "title": "Obligation Count",
          "type": "integer"
        },
        "element_types": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Element Types",
          "type": "object"
        }
      },
      "required": [
        "page_count",
        "element_count",
        "observation_count",
        "obligation_count"
      ],
      "title": "ManifestSummary",
      "type": "object"
    },
    "Obligation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "pending",
            "in_progress",
            "satisfied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "admissible_methods": {
          "items": {
            "type": "string"
          },
          "title": "Admissible Methods",
          "type": "array"
        },
        "method_costs": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Method Costs",
          "type": "object"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/ObligationAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "target_ids",
        "rationale"
      ],
      "title": "Obligation",
      "type": "object"
    },
    "ObligationAttempt": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "method",
        "status",
        "started_at",
        "completed_at"
      ],
      "title": "ObligationAttempt",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "severity",
        "message"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PageDescriptor": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "PageDescriptor",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "filename",
        "path",
        "media_type",
        "byte_size",
        "sha256"
      ],
      "title": "SourceDocument",
      "type": "object"
    }
  },
  "$id": "urn:a11y-devs:schema:processing-manifest:1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manifesto operacional gerado pelo Agente Informacional-Estrutural do Acessília.",
  "properties": {
    "$schema": {
      "default": "urn:a11y-devs:schema:processing-manifest:1.1.0",
      "title": "$Schema",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "status": {
      "default": "extracted",
      "enum": [
        "extracted",
        "planned",
        "processing",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceDocument"
    },
    "extractor": {
      "$ref": "#/$defs/ExtractorRun"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageDescriptor"
      },
      "title": "Pages",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/ManifestElement"
      },
      "title": "Elements",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/Obligation"
      },
      "title": "Obligations",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/ManifestSummary"
    }
  },
  "required": [
    "manifest_id",
    "created_at",
    "source",
    "extractor",
    "title",
    "language",
    "pages",
    "elements",
    "summary"
  ],
  "title": "ProcessingManifest",
  "type": "object"
}
