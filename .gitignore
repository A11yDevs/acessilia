# Compiled Babel locale catalogs (written by scripts/gen_locale_catalogs.py; the runtime compiles the .po in memory)
**/LC_MESSAGES/*.mo

# PDFs temporarios gerados durante benchmark em fixtures
tests/fixtures/tutorials/pagina_*.pdf

# Local AI assistant workspaces and personal settings (must not be committed)
.github/agents/
.claude/
CLAUDE.local.md

*.egg-info
.venv-1
scripts/drbench/builds

