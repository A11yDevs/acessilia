__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
# pytest-testmon's local dependency database
.testmondata*
.DS_Store
htmlcov/
output/

# Runtime, temporary and cache directories
data/
var/
var/cache/rapidocr/
cache/
trash/
temp/
*.db
